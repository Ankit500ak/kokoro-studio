# Normalize text files; keep Windows scripts CRLF so cmd.exe labels work.
* text=auto

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.wav   binary
*.mp3   binary
*.mp4   binary
*.zip   binary
*.db    binary
