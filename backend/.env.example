# Kokoro Studio Environment Configuration
# Copy this file to .env and modify as needed

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# TTS Defaults
DEFAULT_VOICE=am_adam
DEFAULT_SPEED=1.0
SAMPLE_RATE=24000

# TTS Generation Timeouts (increase for CPU-only machines)
TTS_CHUNK_SIZE=400
TTS_CHUNK_TIMEOUT_BASE=180
TTS_CHUNK_TIMEOUT_PER_WORD=1.2
TTS_SINGLE_TIMEOUT_BASE=300
TTS_SINGLE_TIMEOUT_PER_WORD=1.0
TTS_PREVIEW_TIMEOUT=60
STORY_PIPELINE_TIMEOUT=1800
STORY_STAGE_TIMEOUT=360
STORY_ENABLE_ENHANCEMENT=false

# Limits
MAX_TEXT_LENGTH=10000
MIN_SPEED=0.5
MAX_SPEED=1.3

# Gemini API (the ONLY AI provider - StoryForge scripts, metadata, /think)
# Get your API key from: https://aistudio.google.com/apikey
# The base URL is Google AI Studio's OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=60
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.8

# Telegram Bot Default Video Folder (leave empty to mix all folders)
# Options: odlysatisfy, sandsatisfy, sandsound, SandTagious, stablesatisfaction
# Note: this is read by backend/telegram_bot.py via os.getenv (with the
# same list as its built-in fallback) - it is intentionally NOT a
# Settings field in app/core/config.py.
DEFAULT_VIDEO_FOLDERS=odlysatisfy,sandsatisfy,sandsound,SandTagious,stablesatisfaction

# ------------------------------------------------------------
# Telegram auto-pilot bot (optional)
# Get a token from @BotFather, chat id from @userinfobot
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# YouTube Data API v3 OAuth (optional)
# Create creds at https://console.cloud.google.com/ (YouTube Data API v3)
# ------------------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube https://www.googleapis.com/auth/youtube.force-ssl

# ------------------------------------------------------------
# YouTube auto-upload (optional, OFF by default)
# When AUTO_UPLOAD_YOUTUBE=true, every finished render is uploaded
# automatically (no manual POST /api/youtube/upload needed).
# Uploads start PRIVATE by default - review, then publish.
# Requires a completed OAuth connection (visit /api/youtube/auth once).
# ------------------------------------------------------------
AUTO_UPLOAD_YOUTUBE=false
UPLOAD_PRIVACY_STATUS=private
UPLOAD_CATEGORY_ID=22
# Comma-separated extra tags merged into every auto-upload (may be empty)
UPLOAD_TAGS=
# Send a Telegram message with the video URL (or the error) after each
# auto-upload. Uses TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID above.
UPLOAD_NOTIFY_TELEGRAM=true

# Fernet key used to encrypt stored YouTube tokens.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to auto-generate (tokens will NOT survive a restart).
ENCRYPTION_KEY=
